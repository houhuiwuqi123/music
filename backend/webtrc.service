[Unit]
Description=AURU lightweight DHT node (libp2p Kademlia + GossipSub + signalling + iOS gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/webtrc/backend

# NODE_ANNOUNCE：对外公布的地址（不写 IP）
#   /dns4/music.webtrc.eu.cc/tcp/8443/wss  浏览器经 Cloudflare → nginx:8443 → 127.0.0.1:4002
#   /dns4/p2p.webtrc.eu.cc/tcp|udp/4001    节点之间直连（仅 DNS 记录，见 deploy/p2p-domain.md）
# NODE_BOOTSTRAP：其他节点 /dns4/<域名>/tcp/4001/p2p/<peerId>，逗号分隔；单节点留空。
Environment=NODE_ANNOUNCE=/dns4/music.webtrc.eu.cc/tcp/8443/wss,/dns4/p2p.webtrc.eu.cc/tcp/4001,/dns4/p2p.webtrc.eu.cc/udp/4001/quic-v1
Environment=NODE_BOOTSTRAP=
Environment=NODE_GATEWAY_URL=wss://music.webtrc.eu.cc/ws
# 可选 TURN（coturn use-auth-secret），见 deploy/compose.yaml。密钥不要写进仓库，
# 放到 /etc/webtrc.env（chmod 600）：TURN_URLS=… 和 TURN_REST_SECRET=…
EnvironmentFile=-/etc/webtrc.env

ExecStart=/www/wwwroot/webtrc/backend/server -http 127.0.0.1:8080 -key /www/wwwroot/webtrc/backend/state/node.key -listen /ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/udp/4001/quic-v1,/ip4/127.0.0.1/tcp/4002/ws -geoip-db /www/wwwroot/webtrc/backend/GeoLite2-City2.mmdb

Restart=always
RestartSec=5s
User=root
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=webtrc

[Install]
WantedBy=multi-user.target
